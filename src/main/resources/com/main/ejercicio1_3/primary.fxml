<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.main.ejercicio1_3.PrimaryController">
   <children>
      <Label layoutX="30.0" layoutY="35.0" text="Ingrese un número">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtNumero" layoutX="160.0" layoutY="32.0" prefHeight="25.0" prefWidth="120.0" />
      
      <Button fx:id="btnAnalizar" layoutX="320.0" layoutY="30.0" onAction="#btnAnalizarOnAction" prefWidth="80.0" text="Analizar" />
      <Button fx:id="btnLimpiar" layoutX="420.0" layoutY="30.0" onAction="#btnLimpiarOnAction" prefWidth="80.0" text="Limpiar" />
      
      <Label layoutX="30.0" layoutY="95.0" text="Cantidad de cifras" />
      <TextField fx:id="txtCantCifras" editable="false" layoutX="160.0" layoutY="91.0" prefWidth="100.0" />
      
      <Label layoutX="30.0" layoutY="135.0" text="Suma de cifras impares" />
      <TextField fx:id="txtSumaImpares" editable="false" layoutX="160.0" layoutY="131.0" prefWidth="100.0" />
      
      <Label layoutX="30.0" layoutY="175.0" text="Suma de cifras pares" />
      <TextField fx:id="txtSumaPares" editable="false" layoutX="160.0" layoutY="171.0" prefWidth="100.0" />
      
      <Label layoutX="30.0" layoutY="215.0" text="Suma total de cifras" />
      <TextField fx:id="txtSumaTotal" editable="false" layoutX="160.0" layoutY="211.0" prefWidth="100.0" />
      
      <Label layoutX="30.0" layoutY="255.0" text="Cifra mayor" />
      <TextField fx:id="txtCifraMayor" editable="false" layoutX="160.0" layoutY="251.0" prefWidth="100.0" />
      
      <Label layoutX="30.0" layoutY="295.0" text="Cifra menor" />
      <TextField fx:id="txtCifraMenor" editable="false" layoutX="160.0" layoutY="291.0" prefWidth="100.0" />
      
      <Label layoutX="320.0" layoutY="95.0" text="se puede dividir coooon: " />
      <TextArea fx:id="txtDivisores" editable="false" layoutX="320.0" layoutY="120.0" prefHeight="220.0" prefWidth="180.0" />
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</AnchorPane>
